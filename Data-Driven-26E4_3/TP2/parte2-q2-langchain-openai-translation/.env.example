# Provedor: openai | deepseek (presets de URL, modelo e parametros).
# Sem LLM_PROVIDER, o preset e deduzido da OPENAI_BASE_URL.
# Qualquer outra API compativel com a da OpenAI: use OPENAI_BASE_URL.
LLM_PROVIDER=

# Chaves: a especifica do provedor tem prioridade; OPENAI_API_KEY vale para todos.
# Atencao: variaveis definidas no shell tem prioridade sobre este arquivo.
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=

# Opcionais: sobrescrevem o preset do provedor.
#   openai:   (api.openai.com)                 gpt-4o-mini
#   deepseek: https://api.deepseek.com         deepseek-flash, OPENAI_THINKING=disabled
#   Ollama:   http://localhost:11434/v1        (OPENAI_API_KEY=ollama)
OPENAI_MODEL=
OPENAI_BASE_URL=
# Modelos de raciocinio da OpenAI (serie o): low | medium | high.
OPENAI_REASONING_EFFORT=
# DeepSeek: enabled | disabled. O raciocinio vem ligado por padrao (esforco high) e,
# ligado, ignora temperature; para traducao o preset desliga.
OPENAI_THINKING=

OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=2
# 0 desliga o cache em memoria
CACHE_MAXSIZE=1000
